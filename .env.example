# 迷因資料庫：本機設定範例
# 複製成 .env 再填入實際值。.env 已列入 .gitignore 與 .dockerignore，不會進 Git 或 Docker 映像。
# 注意：本程式的 .env 讀取器不支援行尾註解，說明一律寫在獨立的一行。
# 路徑可用相對路徑（以專案根目錄為基準）或絕對路徑。已在系統環境變數設定的值優先於 .env。

# ---------- Discord 同步（選填）----------
# 只有要從 Discord 頻道匯入梗圖時才需要（sync-discord／export-discord 指令）。
# 不填不影響管理頁、手動新增、瀏覽與發布；只有執行上述指令時會提示缺少設定。
# Discord Bot Token，用來讀取頻道訊息。屬於機密，外洩時到 Discord Developer Portal 重新產生。
DISCORD_BOT_TOKEN=
# 要同步的頻道 ID。在 Discord 開啟開發者模式後，對頻道按右鍵「複製頻道 ID」。
DISCORD_CHANNEL_ID=
# DiscordChatExporter CLI 執行檔的路徑。
DISCORD_CHAT_EXPORTER_EXE=~/DiscordChatExporter.Cli.exe

# ---------- 資料庫與檔案位置 ----------
# 主資料庫（SQLite）。CLI 指令沒指定 --db 時使用這個檔案。
MEMES_DB=data\anime_memes.sqlite3
# 原圖目錄：Discord 下載的附件與手動新增的圖片，只留在本機。
MEMES_ATTACHMENT_DIR=data\attachments
# 480P 縮圖目錄（選填，預設 data\thumbnails）。
# MEMES_THUMBNAIL_DIR=data\thumbnails
# 720P 大圖目錄：發布匯出時產生，上傳 R2 前先存在這裡。
MEMES_WEB_DIR=data\web
# 公開發布包的輸出目錄（選填，預設 data\releases）。
# MEMES_RELEASE_ROOT=data\releases
# 標籤分類與自動標籤規則檔，匯入新梗圖時使用。
MEMES_TAG_RULES=config\tags.taxonomy.json

# ---------- 本機 web 指令（不走 Docker 時，選填）----------
# MEMES_WEB_HOST=127.0.0.1
# MEMES_WEB_PORT=3638

# ---------- Cloudflare R2（發布匯出時自動上傳 720P 大圖）----------
# 前五項必填；全部不設定就停用 R2，只設一部分會報錯。
# 改完後要執行 docker compose -p memedatabase --profile private up -d，私人容器才會讀到。
# Cloudflare 帳號 ID（32 字元英數，在 R2 總覽頁右側）。
# MEMES_R2_ACCOUNT_ID=
# R2 API Token 的 Access Key ID（權限選 Object Read & Write，範圍限定該 bucket）。
# MEMES_R2_ACCESS_KEY_ID=
# R2 API Token 的 Secret Access Key。屬於機密，只會顯示一次。
# MEMES_R2_SECRET_ACCESS_KEY=
# bucket 名稱。
# MEMES_R2_BUCKET=
# bucket 綁定的公開網域，只填網域，不加前綴資料夾，結尾不要斜線。例如 https://cdn.example.com
# MEMES_R2_PUBLIC_BASE_URL=
# 物件存放的前綴資料夾（選填，預設 memes/，結尾的 / 不能少）。
# MEMES_R2_PREFIX=memes/

# ---------- 私人 MCP（選填，只在啟用 mcp profile 時需要）----------
# MCP 呼叫端使用的存取權杖，至少 32 字元的隨機字串。
# MEMES_MCP_TOKEN=
