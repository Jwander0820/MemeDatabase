DISCORD_BOT_TOKEN=replace_with_new_rotated_token
DISCORD_CHANNEL_ID=
DISCORD_CHAT_EXPORTER_EXE=~/DiscordChatExporter.Cli.exe

ANIME_MEMES_DB=data\anime_memes.sqlite3
ANIME_MEMES_ATTACHMENT_DIR=data\attachments
ANIME_MEMES_WEB_DIR=data\web
ANIME_MEMES_TAG_RULES=config\tags.taxonomy.json

# Cloudflare R2：匯出發布包時自動上傳 720P 大圖。前五項必填，全部不設定即停用；只設一部分會報錯。
# ANIME_MEMES_R2_ACCOUNT_ID=       # Cloudflare 帳號 ID（32 字元十六進位）
# ANIME_MEMES_R2_ACCESS_KEY_ID=    # R2 API Token 的 Access Key ID
# ANIME_MEMES_R2_SECRET_ACCESS_KEY= # R2 API Token 的 Secret，勿提交
# ANIME_MEMES_R2_BUCKET=           # bucket 名稱
# ANIME_MEMES_R2_PUBLIC_BASE_URL=  # bucket 公開網域，例如 https://img.example.com
# ANIME_MEMES_R2_PREFIX=memes/     # 物件鍵前綴（選填，預設 memes/）
