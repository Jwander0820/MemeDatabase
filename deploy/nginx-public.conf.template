limit_req_zone $binary_remote_addr zone=search:1m rate=${SEARCH_RATE};
server {
    listen 8080;
    server_tokens off;
    autoindex off;
    client_max_body_size 1m;

    # 訪客真實 IP：經 Cloudflare Tunnel 時，請求來自同一 compose 網路內的 cloudflared，
    # 真實 IP 在 CF-Connecting-IP。只信任私有網段與本機來源（對外 port 只綁 127.0.0.1，外部無法直連偽造），
    # 否則所有訪客會共用 cloudflared 的 IP，一個人就能讓全站吃到限流。沒有這個標頭時維持原來源位址。
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header CF-Connecting-IP;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/v1/ {
        limit_req zone=search burst=${SEARCH_BURST} nodelay;
        limit_req_status 429;
        proxy_pass http://public-api:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        # 後端已帶 nosniff；隱藏後由上層的安全標頭統一提供，避免重複的標頭值。
        proxy_hide_header X-Content-Type-Options;
    }
    location /health/ {
        proxy_pass http://public-api:8765;
        proxy_hide_header X-Content-Type-Options;
    }
    location ~ "^/media/[0-9a-f]{64}\.webp$" {
        root /srv;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
    location = / {
        root /usr/share/nginx/gallery;
        add_header Cache-Control no-cache;
        include /etc/nginx/snippets/security-headers.conf;
        try_files /index.html =404;
    }
    location /assets/ {
        alias /usr/share/nginx/gallery/;
        add_header Cache-Control no-cache;
        include /etc/nginx/snippets/security-headers.conf;
    }
    location / { return 404; }
}
