server {
    listen 8080;
    server_tokens off;
    autoindex off;
    client_max_body_size 50m;
    root /usr/share/nginx/admin;
    location = / { add_header Cache-Control no-cache; try_files /index.html =404; }
    location /static/ { add_header Cache-Control no-cache; try_files $uri =404; }
    # 簡潔瀏覽：沿用映像內的公開前端，資料由私人後端的 /api/v1 提供本機完整館藏。
    location = /browse { root /usr/share/nginx/gallery; add_header Cache-Control no-cache; try_files /index.html =404; }
    location /assets/ { alias /usr/share/nginx/gallery/; add_header Cache-Control no-cache; }
    location /api/ {
        proxy_pass http://private-api:8765;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /media/ {
        proxy_pass http://private-api:8765;
        proxy_set_header Host $http_host;
    }
    location /health/ { proxy_pass http://private-api:8765; }
    location / { return 404; }
}
