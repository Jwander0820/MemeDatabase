# 非 root Nginx：基底為 nginxinc/nginx-unprivileged（UID 101，pid 與暫存路徑在 /tmp）。
# 版本鎖定於明確標籤；定期以 `build --pull` 更新並調整標籤（見 docs/vps-deployment.md）。
FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS public
USER root
RUN sed -i 's/worker_processes  auto;/worker_processes  1;/' /etc/nginx/nginx.conf
COPY deploy/nginx-common.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/nginx-public.conf.template /etc/nginx/templates/default.conf.template
COPY src/anime_memes/public_ui /usr/share/nginx/gallery
COPY src/anime_memes/web_static/catalog.css src/anime_memes/web_static/favicon.svg /usr/share/nginx/gallery/
# 確保 UID 101 可讀（建置主機的檔案權限不一定一致）。
RUN chmod -R a+rX /etc/nginx/snippets /etc/nginx/templates /usr/share/nginx
USER 101

FROM public AS private
USER root
COPY deploy/nginx-private.conf.template /etc/nginx/templates/default.conf.template
COPY src/anime_memes/web_templates/index.html /usr/share/nginx/admin/index.html
COPY src/anime_memes/web_static /usr/share/nginx/admin/static
RUN chmod -R a+rX /etc/nginx/templates /usr/share/nginx
USER 101
